<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Job Application Tracker</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>
<div id="notifica"></div>
<header class="header-container">
    <div class="header-top">
      <h1>Job Application Tracker</h1>
      <button id="btn-tema" class="btn-secondario">Tema Scuro</button>
    </div>
    <p>Organizza e monitora lo stato delle tue candidature lavorative</p>
</header>
<main class="container">
    <form id="form-candidatura">
      <div class="form-grid">
        <input type="text" id="input-azienda" placeholder="Nome Azienda" autocomplete="off">
        <input type="text" id="input-ruolo" placeholder="Ruolo (es. Frontend Developer)" autocomplete="off">
        <select id="input-categoria">
          <option value="Sviluppo">Sviluppo</option>
          <option value="Design">Design</option>
          <option value="Marketing">Marketing</option>
          <option value="Altro">Altro</option>
        </select>
        <button type="submit" class="btn-primario">Aggiungi</button>
      </div>
      <p id="errore" class="errore"></p>
    </form>
<div class="controlli-bar">
      <input type="search" id="input-ricerca" placeholder="Cerca azienda o ruolo..." autocomplete="off">
      
      <select id="select-filtro">
        <option value="tutti">Tutti</option>
        <option value="attivi">In Corso</option>
        <option value="completati">Completati</option>
      </select>

      <div class="ordinamento-group">
        <button id="btn-ordina" class="btn-secondario">Ordina per ID</button>
      </div>

      <div class="vista-group">
        <button class="btn-vista attivo" data-vista="lista">Lista</button>
        <button class="btn-vista" data-vista="card">Card</button>
        <button class="btn-vista" data-vista="tabella">Tabella</button>
      </div>
    </div>

    <div id="statistiche" class="statistiche-container"></div>

    <div id="container-dati"></div>
  </main>
  <footer class="footer-container">
    <p>&copy; 2026 Job Application Tracker — Progetto sviluppato in JavaScript</p>
  </footer>
<script src="script.js"></script>
</body>
</html>
